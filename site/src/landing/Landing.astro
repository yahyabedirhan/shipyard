---
// The landing page at `/`: the wordmark set large over slow swells, what shipyard is, who it is for and how it is
// used in three columns, the install lines beside the real panel, then the facts. See site/docs/low-level-design.md.
// It is HTML at build time; only the install tabs and copy buttons hydrate, as islands.
import { CodeBlock, CodeTabs } from '../guide/CodeBlocks';
import { Shot } from '../guide/figures';
import { ASK_AGENT, INSTALL, LINE, NAME, RELEASES, REPO } from '../messaging';
import { inlineMd } from '../reference/parse';
import { FACTS, HOW, WHAT, WHO } from './copy';
import '../guide/docs.css';
import './landing.css';

const INSTALL_TABS = [
  { label: 'From source', lang: 'sh' as const, code: INSTALL.source },
  { label: 'Download', lang: 'sh' as const, code: INSTALL.download },
];
const swells = Array.from({ length: 9 }, (_, i) => i);
---
<div class="dx">
  <div class="land vd">
    <svg class="vd-sea" viewBox="0 0 1200 400" preserveAspectRatio="none" aria-hidden="true">
      {swells.map((i) => (
        <path d={`M0 ${120 + i * 30} C 200 ${90 + i * 30}, 400 ${150 + i * 30}, 600 ${120 + i * 30} S 1000 ${90 + i * 30}, 1200 ${120 + i * 30}`} style={`animation-delay:${-i * 1.3}s;opacity:${0.25 + i * 0.07}`} />
      ))}
    </svg>
    <div class="vd-inner">
      <span class="vd-word"><img src="/logo.png" alt="" width="96" height="96" />{NAME}</span>
      <h1 class="vd-line">{LINE}</h1>
      <div class="vd-cols">
        <div><h2>What</h2><p>{WHAT}</p></div>
        <div><h2>Who</h2><p>{WHO}</p></div>
        <div><h2>How</h2><p set:html={inlineMd(HOW)} /></div>
      </div>
      <div class="vd-row">
        <div class="vd-install">
          <CodeTabs client:visible code={INSTALL_TABS} targets={['source', 'download']} />
          <div class="l-agent">
            <CodeBlock client:visible code={INSTALL.skill} lang="sh" target="skill" />
            <p>Then tell your agent: <q>{ASK_AGENT}</q></p>
          </div>
          <nav class="l-paths" aria-label="Next">
            <a class="l-btn" href="/docs" data-astro-prefetch>Read the docs</a>
            <a class="l-btn quiet" href="/docs#install" data-astro-prefetch>Install</a>
            <a class="l-link" href={RELEASES} target="_blank" rel="noreferrer">Latest release</a>
            <a class="l-link" href={REPO} target="_blank" rel="noreferrer">GitHub</a>
          </nav>
        </div>
        <div class="vd-shots">
          <Shot id="landing-tabs-dark" className="vd-shot" bare />
          <Shot id="landing-list-light" className="vd-shot" bare />
        </div>
      </div>
      <dl class="l-facts row">
        {FACTS.map(([k, v]) => <div><dt>{k}</dt><dd set:html={inlineMd(v)} /></div>)}
      </dl>
    </div>
  </div>
</div>
